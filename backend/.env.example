# API de Gemini usada únicamente para generar embeddings del índice local.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Directorio local de LanceDB; está ignorado por Git.
LANCEDB_PATH=./data/lancedb

# Umbral provisional de recuperación RAG; no representa una probabilidad.
RAG_MIN_SIMILARITY=0.55

# Autenticación local: usa un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=una_cadena_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h

# Solo para configurar una vez una cuenta RR. HH. existente y activa.
INITIAL_RRHH_CORREO=correo_rrhh_existente@example.com
INITIAL_RRHH_PASSWORD=una_contrasena_larga_y_unica_de_al_menos_12_caracteres

# API de DeepSeek para respuestas RAG y resúmenes agregados de reportes diarios.
DEEPSEEK_API_KEY=tu_clave_deepseek
DEEPSEEK_MODEL=deepseek-flash

# Solo para configurar y ejecutar el banco contra cuentas simuladas existentes.
# Primero usa auth:setup-evaluation-user; el script se detiene si la cuenta ya tiene password_hash.
EVALUATION_BASE_URL=http://localhost:3000
EVALUATION_COLABORADOR_CORREO=
EVALUATION_COLABORADOR_PASSWORD=
EVALUATION_RRHH_CORREO=
# La contraseña vigente de RR. HH. se solicita de forma oculta al ejecutar evaluation:run.
